APP_NAME=IncuBrix AI Music Studio
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_REQUEST_BYTES=65536
MAX_IDEMPOTENCY_KEY_LENGTH=255
# Generate a scrypt password hash; do not use plaintext here.
AUTH_USERNAME=replace-with-a-private-username
AUTH_PASSWORD_HASH=replace-with-a-generated-scrypt-hash
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
JOB_DATABASE_PATH=incubrix_jobs.sqlite3
MAX_ACTIVE_GENERATIONS=1
MAX_GENERATIONS_PER_DAY=5
RATE_LIMIT_PER_IP_PER_MINUTE=120
RATE_LIMIT_PER_USER_PER_MINUTE=180
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=10
MUSIC_PROVIDER=stability
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=music_v2_5
PROVIDER_TIMEOUT_SECONDS=300
MAX_GENERATED_AUDIO_BYTES=100000000
MAX_NARRATION_BYTES=50000000
AUDIO_STORAGE_DIR=generated_audio
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
# Placeholder values only; replace them with local-only values before Compose use.
S3_ACCESS_KEY=placeholder
S3_SECRET_KEY=placeholder
S3_REGION=us-east-1
WEBHOOK_SECRET=
OUTBOUND_URL_ALLOWED_HOSTS=[]
