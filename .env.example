APP_NAME=IncuBrix AI Music Studio
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_REQUEST_BYTES=65536
MAX_IDEMPOTENCY_KEY_LENGTH=255
MUSIC_PROVIDER=stability
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=music_v2_5
PROVIDER_TIMEOUT_SECONDS=300
MAX_GENERATED_AUDIO_BYTES=100000000
MAX_NARRATION_BYTES=50000000
AUDIO_STORAGE_DIR=generated_audio
S3_ENDPOINT_URL=
S3_BUCKET_NAME=incubrix-audio
# Local Compose placeholders only; replace these with local-only values.
S3_ACCESS_KEY=local-development-user
S3_SECRET_KEY=replace-with-a-local-development-secret
S3_REGION=us-east-1
WEBHOOK_SECRET=
OUTBOUND_URL_ALLOWED_HOSTS=[]
